{
    "manifestVersion": 1,
    "id": "linceo-devsecops-scan",
    "name": "linceo DevSecOps Scan",
    "version": "0.4.2",
    "publisher": "juandiego-13",
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "description": "Ejecuta linceo (secrets, sca, iac) como tarea nativa de Azure Pipelines, en contenedor o directamente en el agente Linux (modo pypi), sin escribir comandos ni variables a mano.",
    "categories": [
        "Azure Pipelines"
    ],
    "tags": [
        "linceo",
        "devsecops",
        "security",
        "secrets",
        "sca",
        "iac"
    ],
    "icons": {
        "default": "static/logo.png"
    },
    "contributions": [
        {
            "id": "linceo-scan",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/linceo-scan/dist"
            }
        },
        {
            "id": "linceo-install",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/linceo-install/dist"
            }
        }
    ],
    "files": [
        {
            "path": "tasks/linceo-scan/dist"
        },
        {
            "path": "tasks/linceo-install/dist"
        }
    ]
}
